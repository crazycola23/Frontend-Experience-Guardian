{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardian audit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "adapter", "package", "scope", "verdict", "findings", "evidence", "blindspots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "target": { "enum": ["WEB", "MINIPROGRAM"] },
    "adapter": { "enum": ["BROWSER", "WX_NATIVE", "UNIAPP"] },
    "package": { "$ref": "#/$defs/text" },
    "scope": { "enum": ["STATIC", "RUNTIME"] },
    "verdict": { "enum": ["BLOCKED (P0)", "INCOMPLETE", "NEEDS_POLISH (P1)", "PASS"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "blindspots": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "const": "WEB" } } },
      "then": {
        "properties": {
          "adapter": { "enum": ["BROWSER", "UNIAPP"] },
          "findings": { "items": { "properties": { "ruleId": { "$ref": "#/$defs/webRule" } } } }
        }
      },
      "else": {
        "properties": {
          "adapter": { "enum": ["WX_NATIVE", "UNIAPP"] },
          "findings": { "items": { "properties": { "ruleId": { "$ref": "#/$defs/miniRule" } } } }
        }
      }
    },
    {
      "if": { "properties": { "scope": { "const": "STATIC" } } },
      "then": { "properties": { "evidence": { "items": { "properties": { "kind": { "const": "STATIC" } } } } } },
      "else": { "properties": { "evidence": { "contains": { "properties": { "kind": { "const": "RUNTIME" } } } } } }
    },
    {
      "if": { "properties": { "findings": { "minItems": 1 } } },
      "then": { "properties": { "evidence": { "contains": { "properties": { "status": { "const": "FAIL" } } } } } },
      "else": { "properties": { "evidence": { "items": { "properties": { "status": { "not": { "const": "FAIL" } } } } } } }
    },
    {
      "if": { "properties": { "findings": { "contains": { "properties": { "severity": { "const": "P0" } } } } } },
      "then": { "properties": { "verdict": { "const": "BLOCKED (P0)" } } },
      "else": {
        "if": { "$ref": "#/$defs/incomplete" },
        "then": { "properties": { "verdict": { "const": "INCOMPLETE" } } },
        "else": {
          "if": { "properties": { "findings": { "minItems": 1 } } },
          "then": { "properties": { "verdict": { "const": "NEEDS_POLISH (P1)" } } },
          "else": { "properties": { "verdict": { "const": "PASS" } } }
        }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "webRule": {
      "enum": ["W-A1", "W-A2", "W-A3", "W-B1", "W-B2", "W-B3", "W-C1", "W-C2", "W-C3", "W-D1", "W-D2", "W-D3"]
    },
    "miniRule": {
      "enum": ["M-A1", "M-A2", "M-A3", "M-A4", "M-B1", "M-B2", "M-B3", "M-C1", "M-C2", "M-C3", "M-C4", "M-D1", "M-D2", "M-D3"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "location", "problem", "fix"],
      "properties": {
        "ruleId": { "type": "string" },
        "severity": { "enum": ["P0", "P1"] },
        "location": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line"],
              "properties": {
                "file": { "$ref": "#/$defs/text" },
                "line": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "problem": { "$ref": "#/$defs/text" },
        "fix": { "$ref": "#/$defs/text" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "kind", "required", "status", "detail"],
      "properties": {
        "probeId": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["STATIC", "RUNTIME"] },
        "required": { "type": "boolean" },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"] },
        "detail": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "status": { "const": "NOT_APPLICABLE" } } },
      "then": { "properties": { "required": { "const": false } } }
    },
    "observed": { "properties": { "status": { "enum": ["PASS", "FAIL"] } } },
    "incomplete": {
      "anyOf": [
        {
          "properties": {
            "evidence": { "contains": { "properties": { "required": { "const": true }, "status": { "const": "NOT_RUN" } } } }
          }
        },
        { "not": { "properties": { "evidence": { "contains": { "$ref": "#/$defs/observed" } } } } },
        {
          "properties": {
            "scope": { "const": "RUNTIME" },
            "evidence": {
              "not": {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/observed" },
                    { "properties": { "kind": { "const": "RUNTIME" } } }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
